# Sealed watcher and Inbox API, every variable of docs/api-contract.md §8 with FAKE values.
# Copy to .env for a local run. Never commit a real .env (it is git-ignored).
# On Railway, set these as service variables instead.

# "test" or "main". Everything runs on test until the desk decides otherwise.
SEALED_NETWORK=test

# Must equal inbox_id in apps/web/sealed.config.json. [a-z0-9_-]{1,32}
SEALED_INBOX_ID=desk

# Exact origins of the tip page, comma separated. Never "*".
ALLOWED_ORIGINS=https://sealed-example.vercel.app

# lightwalletd servers, origin only, comma separated. At least 2 on main.
# Testnet: only testnet.zec.rocks answers today (B-35). Add a second one when it is live.
SEALED_LIGHTWALLETD_URLS=https://testnet.zec.rocks:443

# Seconds between watcher polls. 5 to 600.
SEALED_POLL_SECONDS=30

# Confirmation depth. Only 3 is accepted (FR-14).
SEALED_CONFIRMATIONS=3

# Argon2id hash of the setup secret. Make it with:
#   echo 'your-setup-secret-at-least-16-chars' | sealed hash-secret
# The secret itself is never stored anywhere.
SEALED_SETUP_SECRET_HASH=$argon2id$v=19$m=19456,t=2,p=1$ZmFrZXNhbHRmYWtlc2FsdA$ZmFrZWhhc2hmYWtlaGFzaGZha2VoYXNoZmFrZWhhc2g

# SQLite file on the volume. The Docker image sets /data/sealed.db.
SEALED_DB_PATH=/data/sealed.db

# 32 random bytes, standard base64. Encrypts the viewing key at rest (B-07).
# Make one with: openssl rand -base64 32
SEALED_DB_KEY=ZmFrZS1kYi1rZXktZmFrZS1kYi1rZXktZmFrZS1kYg==

# Railway sets PORT itself. 8080 for a local run.
PORT=8080

# Testnet judging deploy only (C-24). Leave unset everywhere else. Refused on main.
# SEALED_DEMO_INBOX_ID=desk
